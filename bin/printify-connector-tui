#!/usr/bin/env python3
"""Printify Connector - terminal summary and local benchmark.

Runs the real margin engine and artwork auditor over every bundled blueprint,
times the work, and renders a Unicode braille sparkline of net margins.
Engineered by 1nc0gn30 (@1nc0gn30) - NullAI (https://nullai.tech)
"""
import argparse
import json
import sys
import time
from pathlib import Path

SRC_DIR = Path(__file__).resolve().parent.parent / "src"
if str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from printify_connector import __version__  # noqa: E402
from printify_connector.artwork_auditor import audit_artwork_dimensions  # noqa: E402
from printify_connector.catalog import BLUEPRINTS, PRINT_PROVIDERS, list_blueprints  # noqa: E402
from printify_connector.margin_engine import calculate_multi_channel_margins  # noqa: E402

BRAILLE_BASE = 0x2800


def braille_sparkline(vals):
    if not vals:
        return ""
    lo, hi = min(vals), max(vals)
    span = (hi - lo) or 1.0
    norm = [(v - lo) / span for v in vals]
    if len(norm) % 2:
        norm.append(norm[-1])
    out = []
    for i in range(0, len(norm), 2):
        v1 = max(0, min(3, int(norm[i] * 3.99)))
        v2 = max(0, min(3, int(norm[i + 1] * 3.99)))
        out.append(chr(BRAILLE_BASE | (0x40, 0x04, 0x02, 0x01)[v1] | (0x80, 0x20, 0x10, 0x08)[v2]))
    return "".join(out)


def _first_margin(res):
    """Representative net margin % (default Etsy channel) from the engine result."""
    return float(res.get("active_summary", {}).get("profit_margin_pct", 0.0))


def run(price: float, iterations: int):
    bps = list_blueprints()
    ids = [bp["id"] for bp in bps]
    margins = []
    t0 = time.perf_counter()
    for _ in range(iterations):
        margins = []
        for bid in ids:
            res = calculate_multi_channel_margins(blueprint_id=bid, retail_price=price, shipping_charged=4.99)
            margins.append(_first_margin(res))
            audit_artwork_dimensions(blueprint_id=bid, width_px=4500, height_px=5400, file_name="bench.png")
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    return ids, margins, elapsed_ms


def main():
    ap = argparse.ArgumentParser(description="Printify Connector terminal summary and local benchmark")
    ap.add_argument("--json", action="store_true", help="Output JSON summary and exit")
    ap.add_argument("--price", type=float, default=28.0, help="Retail price used for the margin sweep (default: 28.0)")
    ap.add_argument("--iterations", type=int, default=50, help="Benchmark iterations (default: 50)")
    args = ap.parse_args()

    ids, margins, elapsed_ms = run(args.price, max(1, args.iterations))
    calcs = len(ids) * max(1, args.iterations) * 2
    summary = {
        "tool": "printify-connector",
        "version": __version__,
        "blueprints": len(BLUEPRINTS),
        "providers": len(PRINT_PROVIDERS),
        "retail_price": args.price,
        "net_margin_pct_by_blueprint": dict(zip([str(i) for i in ids], margins)),
        "benchmark": {"calculations": calcs, "elapsed_ms": round(elapsed_ms, 3),
                      "per_calc_us": round(elapsed_ms * 1000.0 / calcs, 2) if calcs else None},
        "braille_margin_sparkline": braille_sparkline(margins),
    }
    if args.json:
        print(json.dumps(summary, indent=2))
        return 0

    print(f"Printify Connector v{__version__}  |  1nc0gn30 - NullAI")
    print(f"Blueprints: {summary['blueprints']}   Providers: {summary['providers']}   Price: ${args.price:.2f}")
    print(f"Net margin sweep: {summary['braille_margin_sparkline']}")
    for bid, m in zip(ids, margins):
        print(f"  {str(bid)[:32]:<32} {m:7.2f}%")
    b = summary["benchmark"]
    print(f"Benchmark: {b['calculations']} calculations in {b['elapsed_ms']} ms ({b['per_calc_us']} us/calc)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
